<% provide(:title, "パスワードの変更") %>

<div class="container mt-6 pb-10">
  <h2 class="mb-6 text-center">パスワードの変更</h2>

  <div class="flex justify-center">
    <div class="w-full md:w-1/2">
      <%= form_with model: @user, url: account_password_path, method: :patch, local: true do |f| %>
        <%= render "devise/shared/error_messages", resource: @user %>

        <div class="mb-3">
          <%= f.label :password, "新しいパスワード" %>
          <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
        </div>

        <div class="mb-3">
          <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
          <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
        </div>

        <div class="mb-3">
          <%= f.label :current_password, "現在のパスワード（確認用）" %>
          <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
          <div class="form-text">安全のため、現在のパスワードの入力が必要です。</div>
        </div>

        <%# ボタン行：小さい画面は縦2段（更新が上）、md 以上は横並び %>
        <div class="mt-6 flex flex-col-reverse md:flex-row justify-center gap-4">
          <%= link_to "キャンセル", profile_path, class: "btn btn-outline-secondary md:w-40 text-center", role: "button" %>
          <%= f.submit "更新する", class: "btn btn-primary md:w-40" %>
        </div>

      <% end %>
    </div>
  </div>
</div>