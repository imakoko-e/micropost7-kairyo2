<% provide(:title, "Edit user") %>

<div class="container mt-6 pb-10">
  <h2 class="mb-6 text-center">ユーザー情報の変更</h2>

  <div class="flex justify-center">
    <div class="w-full md:w-1/2">

      <%= form_with(model: @user, url: user_registration_path, builder: ApplicationHelper::CustomFormBuilder) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= f.label :name %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: 'form-control' %>

        <%# メール変更セクション %>
        <h4 id="change-email" class="mt-4">メールアドレスの変更</h4>
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email", class: 'form-control' %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div>
            Currently waiting confirmation for: <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <%# パスワード変更セクション %>
        <h4 id="change-password" class="mt-4">パスワードの変更</h4>
        <%= f.label :password, "パスワード（6文字以上）" %>
        <i>（変更しない場合は空白のままにしてください）</i>
        <%= f.password_field :password, autocomplete: "new-password", class: 'form-control' %>

        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control' %>

        <%= f.label :current_password %>
        <i>（パスワード変更には、現在のパスワードが必要です）</i>
        <%= f.password_field :current_password, autocomplete: "current-password", class: 'form-control' %>

        <div class="mt-6 flex flex-col-reverse md:flex-row justify-center gap-4">
          <%= link_to "戻る", :back, class: "btn btn-outline-secondary md:w-40 text-center" %>
          <%= f.submit "更新", class: "btn btn-primary md:w-40 text-center" %>
        </div>
      <% end %>

      <div class="gravatar_edit mt-6 text-center">
        <%= gravatar_for @user %>
        <div class="mt-2">
          <a href="https://gravatar.com/emails" target="_blank" rel="noopener">画像の変更</a>
        </div>
      </div>

      <hr class="my-4 border-gray-300">

      <%# アカウントの削除 %>
      <div class="mt-6 flex justify-center">
        <%= button_to "アカウントの削除", destroy_user_path(@user),
            data: { turbo_confirm: "本当に削除してよろしいですか？" },
            method: :delete,
            class: "btn btn-secondary min-w-40 px-6 text-center" %>
      </div>
    </div>
  </div>
</div>
