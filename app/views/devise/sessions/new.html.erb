<% provide(:title, "Log in") %>

<div class="container mt-6 pb-10">
  <h2 class="mb-6 text-center">ログイン</h2>

  <div class="flex justify-center">
    <div class="w-full md:w-1/2">

      <%= form_with(model: @user, url: user_session_path, local: true, builder: ApplicationHelper::CustomFormBuilder) do |f| %>
        <%= render "devise/shared/error_messages", resource: f.object %>

        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control' %>

        <%= f.label :password %>
        <%= link_to "（パスワードを忘れた方はこちらへ）", new_user_password_path %>
        <%= f.password_field :password, class: 'form-control' %>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center mt-3">
            <%= f.check_box :remember_me, class: 'form-check-input' %>
            <%= f.label :remember_me, class: 'form-check-label' do %>
              <span>次回から自動でログイン</span>
            <% end %>
          </div>
        <% end %>

        <div class="mt-6 flex justify-center">
          <%= f.submit "ログイン", class: "btn btn-primary min-w-40 px-6 text-center" %>
        </div>
      <% end %>

      <hr class="my-4 border-gray-300">
      <%# Google ログイン %>
      <div class="google-login text-center">
        <p>またはGoogleアカウントでログイン 😊</p>
        <div class="mt-3 flex justify-center">
          <%= link_to "Googleでログイン", user_google_oauth2_omniauth_authorize_path, class: "btn btn-outline-primary min-w-40 px-6 text-center" %>
        </div>
      </div>
      <hr class="my-4 border-gray-300">

      <p class="text-center">新規の方は <%= link_to "ユーザー登録へ", new_user_registration_path %></p>
    </div>
  </div>

  <%= render "devise/shared/links" %>
</div>
