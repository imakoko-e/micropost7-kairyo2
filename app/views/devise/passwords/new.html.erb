<% provide(:title, "Forgot password") %>

<div class="container mt-6 pb-10">
  <h2 class="mb-6 text-center">パスワードを忘れた場合のメール送信</h2>

  <div class="flex justify-center">
    <div class="w-full md:w-1/2">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, builder: ApplicationHelper::CustomFormBuilder) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control' %>

        <div class="mt-6 flex justify-center">
          <%= f.submit "パスワードのリセット手順をメール送信する", class: "btn btn-primary min-w-40 px-6 text-center" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "devise/shared/links" %>
</div>
