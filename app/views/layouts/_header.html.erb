<%# ナビゲーションバー（固定ヘッダー） %>
<header>
  <nav class="fixed top-0 left-0 right-0 z-50 bg-gray-900 text-white"
       data-controller="navbar">
    <%# ボディの .container と同じクラスで幅を揃える %>
    <div class="container flex flex-wrap items-center justify-between">

      <%# ロゴ：高さは h-14（56px） %>
      <%= link_to "Micropost 7 改良型", root_path,
          id: "logo",
          class: "flex items-center h-14 text-white font-bold text-2xl uppercase tracking-tight hover:text-white hover:no-underline" %>

      <%# ハンバーガーボタン（md未満のモバイルのみ表示） %>
      <button class="md:hidden flex items-center h-14 text-white hover:text-gray-300 focus:outline-none"
              type="button"
              aria-label="メニューを開閉する"
              data-action="click->navbar#toggle">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

      <%# ナビゲーションメニュー
          ・md以上: ロゴと同じ行に横並び（w-auto）、h-14 で上下中央に揃える
          ・md未満: 初期非表示。ハンバーガーボタンで縦並び表示（w-full で折り返し） %>
      <div class="hidden w-full md:flex md:w-auto md:items-center md:h-14"
           id="navbar-menu"
           data-navbar-target="menu">
        <ul class="flex flex-col md:flex-row md:items-center md:space-x-1 pb-3 md:pb-0">

          <li>
            <%= link_to "ホーム", root_path,
                class: "nav-link block px-3 py-2 text-sm text-white hover:text-gray-300 #{active_if('static_pages', 'home')}" %>
          </li>
          <li>
            <%= link_to "ヘルプ", help_path,
                class: "nav-link block px-3 py-2 text-sm text-white hover:text-gray-300 #{active_if('static_pages', 'help')}" %>
          </li>

          <% if user_signed_in? %>
            <li>
              <%= link_to "ユーザー一覧", users_path,
                  class: "nav-link block px-3 py-2 text-sm text-white hover:text-gray-300 #{active_if('users', 'index')}" %>
            </li>

            <%# アカウントドロップダウン %>
            <li class="relative" data-controller="dropdown">
              <button class="flex items-center gap-1 px-3 py-2 text-sm text-white hover:text-gray-300 w-full md:w-auto text-left"
                      type="button"
                      data-action="click->dropdown#toggle">
                アカウント
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 9l-7 7-7-7"/>
                </svg>
              </button>

              <%# ドロップダウンメニュー本体
                  ・デスクトップ: ボタン直下に絶対配置で右寄せ
                  ・モバイル: インラインで縦並び %>
              <ul class="hidden md:absolute md:right-0 md:top-full w-full md:w-48 bg-white md:rounded md:shadow-lg py-1 z-50 text-gray-700 md:mt-1"
                  data-dropdown-target="menu"
                  data-action="click@window->dropdown#hide">
                <li>
                  <%= link_to "投稿一覧", current_user,
                      class: "block px-4 py-2 text-sm hover:bg-gray-100 #{active_if('users', 'show')}" %>
                </li>
                <li>
                  <%= link_to "ユーザー情報一覧", profile_path,
                      class: "block px-4 py-2 text-sm hover:bg-gray-100" %>
                </li>
                <li>
                  <%= link_to "メールアドレスの変更", edit_email_path,
                      class: "block px-4 py-2 text-sm hover:bg-gray-100" %>
                </li>
                <li>
                  <%= link_to "パスワードの変更", edit_password_path,
                      class: "block px-4 py-2 text-sm hover:bg-gray-100" %>
                </li>
                <li>
                  <%= link_to "ユーザー情報変更", edit_profile_path,
                      class: "block px-4 py-2 text-sm hover:bg-gray-100" %>
                </li>
                <li><hr class="my-1 border-gray-200"></li>
                <li>
                  <%= link_to "ログアウト", destroy_user_session_path,
                      data: { "turbo-method": :delete },
                      class: "block px-4 py-2 text-sm hover:bg-gray-100" %>
                </li>
              </ul>
            </li>

          <% else %>
            <li>
              <%= link_to "ログイン", new_user_session_path,
                  class: "nav-link block px-3 py-2 text-sm text-white hover:text-gray-300 #{active_if('sessions', 'new')}" %>
            </li>
          <% end %>

        </ul>
      </div>

    </div>
  </nav>
</header>
