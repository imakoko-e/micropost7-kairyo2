<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Action Cable（WebSocket）の接続先 %>
    <%= action_cable_meta_tag %>

    <%# importmap で application.js を読み込む（javascript_include_tag は要らない） %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Bootstrap Icons（bi-*）は Tailwind と関係なく使えるので、CDN から読み込む %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.min.css">

    <%= favicon_link_tag('logo_blue.png') %>

    <title><%= full_title(yield(:title)) %></title>
  </head>
  <body>
    <%= render 'layouts/header' %>
    <div class="container">
      <%# Devise の notice・alert があればそれを、無ければ flash を表示する %>
      <% if notice %>
        <p class="alert-success">【Devise通知】<%= notice %></p>
      <% elsif alert %>
        <p class="alert-danger">【Devise警告】<%= alert %></p>
      <% else %>
        <% flash.each do |message_type, message| %>
          <%# message_type（notice・alert・success・danger など）ごとに、Tailwind で alert-* のクラスを定義してある %>
          <div class="alert-<%= message_type %>">
            <%= message %>
          </div>
        <% end %>
      <% end %>

      <%= yield %>
      <%= render 'layouts/footer' %>
      <%# 開発のときだけ params を表示する %>
      <%= debug(params) if Rails.env.development? %>
    </div>
  </body>
</html>
