<%# 通知の画面（PagesController）のレイアウト。ロゴだけのナビゲーションバー %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for?(:title) ? yield(:title) : "確認ページ" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Action Cable（WebSocket）の接続先 %>
    <%= action_cable_meta_tag %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Bootstrap Icons（bi-*）は Tailwind と関係なく使えるので、CDN から読み込む %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.min.css">

    <%= javascript_include_tag "application", defer: true, "data-turbo-track": "reload", type: "module" %>

  </head>
  <body>
    <nav class="fixed top-0 left-0 right-0 z-50 bg-gray-900 text-white flex items-center justify-center h-16">
      <h3 id="logo" class="text-white font-bold text-xl uppercase tracking-tight m-0">Micropost 7 改良型</h3>
    </nav>

    <%= yield %>

  </body>
</html>