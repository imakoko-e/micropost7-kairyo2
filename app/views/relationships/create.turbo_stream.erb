<%# フォローしたとき：フォローのボタンを「解除」のボタンに替え、フォロワーの人数を更新する %>
<%# turbo_stream.update は、指定した id の要素の中身を、ブロックの結果に置き換える %>
<%= turbo_stream.update "follow_form" do %> 
  <%= render partial: "users/unfollow" %>
<% end %>

<%# shared/_stats.html.erb の id="followers" の人数（@user はコントローラーで用意する） %>
<%= turbo_stream.update "followers" do %>
  <%= @user.followers.count %> 
<% end %>
