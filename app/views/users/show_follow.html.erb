<%# フォロー一覧とフォロワー一覧（following・followers の両方で使う） %>
<% provide(:title, @title) %>

<div class="container mt-6 pb-10">
  <h2 class="mb-6 text-center"><%= @title %></h2>

  <div class="flex flex-wrap">
    <%# サイドバー %>
    <aside class="w-full md:w-1/3 pr-4">
      <section class="user_info text-center md:text-left">
        <%= gravatar_for @user %>
        <p class="mt-2 text-xl font-bold"><%= @user.name %></p>
        <span><%= link_to "プロフィール表示", @user %></span>
        <span><strong>投稿数:</strong> <%= @user.microposts.count %></span>
      </section>

      <section class="stats mt-4">
        <%# フォロー・フォロワーの人数 %>
        <%= render 'shared/stats' %>

        <% if @users.any? %>
          <div class="user_avatars">
            <% @users.each do |user| %>
              <%# ユーザーの小さい画像をタイル状に並べる %>
              <%= link_to gravatar_for(user, size: 30), user %>
            <% end %>
          </div>
        <% end %>
      </section>
    </aside>

    <%# ユーザーの一覧 %>
    <div class="w-full md:w-2/3">
      <% if @users.any? %>
        <ul class="users follow">
          <%= render @users %>
        </ul>
        <%= will_paginate %>
      <% end %>
    </div>
  </div>
</div>
