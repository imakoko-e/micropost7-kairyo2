# 開発用（docker-compose.local.yml）の環境変数。`cp .env.example .env` で写して使う。.env は Git に入らない。
# 本番用は .env.production.example を参照。

# docker compose が使う構成ファイル（本番用の docker-compose.yml を誤って使わないように）
COMPOSE_FILE=docker-compose.local.yml

# コンテナのユーザーをホストに合わせる（`id -u`・`id -g` の値）
UID=1000
GID=1000

# ホスト側のポート。ほかのアプリと同時に動かすときは変える
APP_PORT=3000
DB_PORT=5432

# 開発用 DB のパスワード（手元だけで使う値を入れる）
DB_PASSWORD=

# Google ログインを手元で試すときだけ入れる
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
