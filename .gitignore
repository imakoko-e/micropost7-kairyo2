# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor or operating system, you probably want to add a global ignore instead:
# テキスト エディターまたはオペレーティング システムによって生成された一時ファイルを無視している場合は、代わりにグローバル無視を追加することをお勧めします。
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# 生成されたデータベースファイルはGitに登録しない
# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
# 開発中にアップロードされたファイルを無視します。
/storage/*
/storage_data/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# 認証情報などの復号化に使うマスターキーを無視する。
/config/master.key

# 開発中の postgresql ファイルを無視します。
/postgres_data/
/postgresql_v14/*

# その他
db.log
rails-app.tar

/app/assets/builds/*
!/app/assets/builds/.keep

# 環境変数設定ファイル.env.production はGitに入れない
.env
.env.*
!.env.example
!.env.production.example
*.backup_*
config/*.key
config/*.key.backup_*
config/credentials.yml.enc.backup_*
# エディターの設定は Git に入れない（.idea/ にはアカウント名入りのパスが入る）
/.idea/
*.iml
/.vscode/

